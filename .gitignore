# ── Laravel ───────────────────────────────────────────────────────
*.log
.env
.env.backup
.env.production
.env.*.local
/auth.json
/storage/*.key
/storage/pail
/public/build
/public/hot
/public/storage
/bootstrap/cache/*.php
# The directories themselves are tracked so a fresh clone can boot: Laravel
# writes compiled views and sessions into them and refuses to start if they
# are missing. Only their contents are ignored.
/storage/framework/cache/*
!/storage/framework/cache/data
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/app/private/*
!/storage/app/private/.gitkeep

# ── Dependencies ──────────────────────────────────────────────────
/vendor
/node_modules

# ── Test artefacts ────────────────────────────────────────────────
# Only the output of a run is ignored. The suite itself is part of the
# project, so nothing here may match tests/ as a whole.
/coverage
.phpunit.result.cache
/.phpunit.cache
/tests/e2e/.output
/tests/e2e/.report
/tests/e2e/.auth
/playwright-report
/test-results

# ── Local tooling ─────────────────────────────────────────────────
/.claude

# ── Databases ─────────────────────────────────────────────────────
*.sqlite
*.sqlite3
/database/*.sqlite

# ── Runtime data ──────────────────────────────────────────────────
# Uploaded files and per-tenant folders are created while the app runs.
# public/images holds the three assets that ship with it and stays.
/storage/tenant*
/public/tenants
/public/uploads

# ── IDE / editors ─────────────────────────────────────────────────
/.idea
/.vscode
/.fleet
/.nova
/.zed
.DS_Store
Thumbs.db
.phpactor.json
* copy.*

# ── Local notes ───────────────────────────────────────────────────
/docs
/PLAN.md
