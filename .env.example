APP_NAME=TaskSystem
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The landlord database. Each workspace gets its own, created by the tenancy
# package when the tenant is.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tasksystem_landlord
DB_USERNAME=root
DB_PASSWORD=

# Leave SESSION_DOMAIN empty so the cookie is scoped to whichever host serves
# the request. Workspaces are resolved by domain, so a cookie pinned to one
# host is never sent to another and every sign-in comes back as a 419.
#
# In production, set it to a leading-dot parent of every workspace domain
# (.example.com) and turn the two HTTPS settings back on:
#   SESSION_SECURE_COOKIE=true
#   FORCE_HTTPS=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
FORCE_HTTPS=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb WebSocket server. BROADCAST_CONNECTION above is set to log, so none of
# this is needed until broadcasting is switched on.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# The parent of every workspace domain.
TENANT_BASE_DOMAIN=localhost

# Run after a deploy:
#   php artisan storage:link
#   php artisan migrate --path=database/migrations/landlord --force
#   php artisan tenants:migrate --force
#   php artisan queue:work          (run it under a supervisor)
#   php artisan schedule:work       (recurring invoices depend on it)

# The super admin LandlordSeeder creates. Set both before seeding anywhere
# real; left empty, the seeder falls back to a known password and says so.
SUPER_ADMIN_EMAIL=admin@task-system.localhost
SUPER_ADMIN_PASSWORD=
